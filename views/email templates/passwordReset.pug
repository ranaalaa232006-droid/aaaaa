doctype html
html
  head
    meta(charset='UTF-8')
    meta(name='viewport' content='width=device-width, initial-scale=1.0')
    title= subject

  body
    h1 Password Reset Request
    p Hi #{firstName},
    p Forgot your password? No problem. Click the link below to reset your password.

    a(href=url) Reset your password

    p If you did not make this request, please ignore this email.